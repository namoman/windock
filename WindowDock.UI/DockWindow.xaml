<Window x:Class="WindowDock.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windock"
        Width="360"
        Height="480"
        MinWidth="280"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#F21E1E1E"
            BorderBrush="#663A7AFE"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="0,0,0,10"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Windock"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F5F5F5"
                           VerticalAlignment="Center" />
                <Button Content="×"
                        DockPanel.Dock="Right"
                        Width="28"
                        Height="28"
                        Margin="8,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#CCCCCC"
                        FontSize="16"
                        Click="CloseButton_Click" />
            </DockPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,12">
                <Button Content="현재 창 보관 (Ctrl+Shift+P)"
                        Command="{Binding ParkForegroundCommand}"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        Background="#FF3A7AFE"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="창 선택..."
                        Command="{Binding ParkFromPickerCommand}"
                        Padding="10,6"
                        Background="#FF2A2A2A"
                        Foreground="#F0F0F0"
                        BorderBrush="#FF444444" />
            </StackPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding ParkedWindows}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#F0F0F0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Image Source="{Binding Icon}"
                                   Width="20"
                                   Height="20"
                                   Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SubText}"
                                           FontSize="11"
                                           Foreground="#AAAAAA" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Background" Value="#332A2A2A" />
                        <Setter Property="BorderBrush" Value="#443A7AFE" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <EventSetter Event="MouseDoubleClick" Handler="ParkedItem_MouseDoubleClick" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#553A7AFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#773A7AFE" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Grid.Row="3"
                       Margin="0,10,0,0"
                       Foreground="#888888"
                       FontSize="11"
                       Text="더블클릭으로 창 복원 · 작업표시줄에서 숨긴 창은 여기서 관리합니다." />
        </Grid>
    </Border>
</Window>
