<Window x:Class="WindowDock.UI.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="창 선택"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="#F0F0F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="보관할 창을 선택하세요."
                   FontSize="14" />

        <ListBox x:Name="WindowsList"
                 Grid.Row="1"
                 Background="#FF2A2A2A"
                 BorderBrush="#FF444444">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProcessName}"
                                   FontSize="11"
                                   Foreground="#AAAAAA" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="보관"
                    Width="90"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Click="ParkButton_Click" />
            <Button Content="취소"
                    Width="90"
                    Padding="8,6"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
