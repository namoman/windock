<Window x:Class="WindowDock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowDock.UI.Views"
        xmlns:vm="clr-namespace:WindowDock.UI.ViewModels"
        Title="Windock"
        Width="400"
        Height="720"
        MinWidth="360"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/WindockTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="#33404752"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource MicaBrush}"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button Content="×"
                            DockPanel.Dock="Right"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource OnSurfaceVariantBrush}"
                            FontSize="16"
                            Click="CloseButton_Click"
                            Cursor="Hand" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding AppIcon}"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,16">
                <views:DashboardView DataContext="{Binding}" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}" />
                <views:WindowsView DataContext="{Binding}" Visibility="{Binding IsWindowsPage, Converter={StaticResource BoolToVis}}" />
                <views:ShortcutsView DataContext="{Binding}" Visibility="{Binding IsShortcutsPage, Converter={StaticResource BoolToVis}}" />
                <views:SettingsView DataContext="{Binding}" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Bottom Nav -->
            <Border Grid.Row="2"
                    Background="{StaticResource MicaBrush}"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="8,8,8,12">
                <UniformGrid Columns="4">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:AppPage.Dashboard}">
                        <StackPanel>
                            <TextBlock Text="🏠" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Dashboard" FontSize="10" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:AppPage.Windows}">
                        <StackPanel>
                            <TextBlock Text="🪟" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows" FontSize="10" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:AppPage.Shortcuts}">
                        <StackPanel>
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Shortcuts" FontSize="10" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:AppPage.Settings}">
                        <StackPanel>
                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="10" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
