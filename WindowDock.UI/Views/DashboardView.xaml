<UserControl x:Class="WindowDock.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="시스템 상태" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SystemStatus}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="숨긴 창" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock Text="{Binding HiddenCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <Button Content="복원"
                                    DockPanel.Dock="Right"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static vm:AppPage.Windows}"
                                    xmlns:vm="clr-namespace:WindowDock.UI.ViewModels"
                                    Background="Transparent"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderThickness="0"
                                    VerticalAlignment="Bottom"
                                    Cursor="Hand" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="현재 레이아웃" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Text="기본" DockPanel.Dock="Right" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="Bold" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" Background="{StaticResource SurfaceContainerHighestBrush}" CornerRadius="8" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="단일 창 모드" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <TextBlock Text="보관한 창은 독에서 관리" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12" Padding="0">
                <Button Command="{Binding ToggleHideAllCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="모든 창 숨기기" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                            <TextBlock Text="열린 창을 한 번에 보관" FontSize="13" Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding HideAllEnabled, Mode=OneWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      DockPanel.Dock="Right"
                                      IsHitTestVisible="False" />
                    </DockPanel>
                </Button>
            </Border>

            <TextBlock Text="빠른 실행" Style="{StaticResource SectionLabelStyle}" Margin="4,0,0,8" />

            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Command="{Binding ParkForegroundCommand}"
                        Margin="0,0,6,6"
                        Padding="16"
                        Background="{StaticResource SurfaceContainerHighBrush}"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="📌" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="현재 창 보관" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:AppPage.Windows}"
                        xmlns:vm="clr-namespace:WindowDock.UI.ViewModels"
                        Margin="6,0,0,6"
                        Padding="16"
                        Background="{StaticResource SurfaceContainerHighBrush}"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🪟" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="창 목록 보기" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
