<UserControl x:Class="WindowDock.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="일반 설정" Style="{StaticResource PageTitleStyle}" FontSize="16" Margin="0,0,0,12" />

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right"
                                  IsChecked="{Binding StartWithWindows}"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    <StackPanel>
                        <TextBlock Text="Windows 시작 시 실행" FontSize="15" Foreground="{StaticResource OnSurfaceBrush}" />
                        <TextBlock Text="시스템 부팅 시 Windock을 백그라운드에서 자동으로 시작합니다."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="0,4,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right"
                                  IsChecked="{Binding HideTaskbarWhileActive}"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    <StackPanel>
                        <TextBlock Text="작업 표시줄 자동 숨기기" FontSize="15" Foreground="{StaticResource OnSurfaceBrush}" />
                        <TextBlock Text="Windock 사용 중 기본 Windows 작업 표시줄을 숨깁니다. (준비 중)"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="0,4,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="모양 및 동작" Style="{StaticResource PageTitleStyle}" FontSize="16" Margin="0,0,0,12" />

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="애니메이션 속도" Foreground="{StaticResource OnSurfaceBrush}" />
                        <TextBlock Text="{Binding AnimationSpeedLabel}" DockPanel.Dock="Right" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="2" Value="{Binding AnimationSpeed}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <UniformGrid Columns="3">
                        <TextBlock Text="느림" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <TextBlock Text="보통" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="빠름" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Right" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="독 투명도" Foreground="{StaticResource OnSurfaceBrush}" />
                        <TextBlock Text="{Binding DockOpacityLabel}" DockPanel.Dock="Right" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                    </DockPanel>
                    <Slider Minimum="10" Maximum="100" Value="{Binding DockOpacity}" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SurfaceContainerHighBrush}" Margin="0,0,0,8" ClipToBounds="True">
                    <Image Source="{Binding AppIcon}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="Windock" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AppVersion, StringFormat=버전 {0}}" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                <Button Content="GitHub"
                        Command="{Binding OpenGitHubCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
